SERVER_ADDRESS=:8000
KNOWLEDGE_BASE_PATH=data/disease_database.json

# Paste the Google Gemini API key here, then rename this file to .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT=30s
AI_RETRIES=10

# Optional: run without Gemini during frontend development.
# AI_MOCK_DISEASE_ID=tomato_early_blight
